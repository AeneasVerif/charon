= <opaque>

pub const test_crate::mod_reduce::{promoted_const}: str = "assertion failed: a < 100" with_metadata(25usize)

pub fn test_crate::mod_reduce(a: u32) -> u32
{
    let mut _0: u32; // return
    let a: u32; // arg #1
    let mut _2: bool; // anonymous local
    let mut _3: u32; // anonymous local
    let mut _4: u32; // anonymous local
    let mut _5: &'1 str; // anonymous local

    storage_live(_0)
    storage_live(_2)
    storage_live(_3)
    _3 = copy a
    _2 = move _3 < const 100u32
    storage_live(_5)
    _5 = &test_crate::mod_reduce::{promoted_const} with_metadata(const 25usize)
    assert(move _2 == true) else panic(core::panicking::panic(move _5))
    ↳⚡ storage_dead(_5)
        unwind_continue
    storage_dead(_3)
    storage_dead(_2)
    storage_live(_4)
    _4 = copy a
    _0 = core::num::{u32}::wrapping_add(move _4, const 1u32)
    ↳⚡ storage_dead(a)
        storage_dead(_5)
        unwind_continue
    storage_dead(_4)
    storage_dead(a)
    storage_dead(_5)
    return
}



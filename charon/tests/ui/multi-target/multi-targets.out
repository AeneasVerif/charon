pub fn test_crate::f3_different::i686-unknown-linux-gnu() -> u64
{
    let mut _0: u64; // return
    let mut _1: u64; // anonymous local
    let mut _2: u64; // anonymous local

    storage_live(_0)
    storage_live(_2)
    storage_live(_1)
    _1 = test_crate::f2_same()
    ↳⚡ storage_dead(_2)
        unwind_continue
    _2 = const 1u64 panic.+ copy _1
    _0 = move _2
    storage_dead(_1)
    storage_dead(_2)
    return
}


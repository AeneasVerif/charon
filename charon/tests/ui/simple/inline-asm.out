#[fundamental]
#[lang_item(MetaSized)]
pub trait core::marker::MetaSized<Self>

#[fundamental]
#[lang_item(Sized)]
pub trait core::marker::Sized<Self>
{
    proof ImpliedClause0: (Self: core::marker::MetaSized)
    non-dyn-compatible
}

struct () {}

struct (_, _)<A, B>
where
    TraitClause0: (A: core::marker::Sized),
{
  _0: A,
  _1: B,
}

fn test_crate::main()
{
    let _0: (); // return

    storage_live(_0)
    _0 = ()
    asm!("nop") {
        fallthrough => {
            _0 = ()
            return
        }
    }
    ↳⚡ undefined_behavior
}

fn test_crate::multiple_targets(x: u32) -> u32
{
    let _0: u32; // return
    let x: u32; // arg #1

    storage_live(_0)
    asm!("jmp {0}", label(branch 0)) {
        fallthrough => {
            _0 = copy x
            storage_dead(x)
            return
        }
        label 0 => {
            x = const 1u32
            _0 = copy x
            storage_dead(x)
            return
        }
    }
    ↳⚡ undefined_behavior
}

fn test_crate::ASM_STATIC() -> u64
{
    let _0: u64; // return

    storage_live(_0)
    _0 = const 0u64
    return
}

static test_crate::ASM_STATIC: u64 = test_crate::ASM_STATIC()

fn test_crate::asm_target()
{
    let _0: (); // return

    storage_live(_0)
    _0 = ()
    _0 = ()

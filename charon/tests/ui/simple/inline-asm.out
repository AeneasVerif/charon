fn test_crate::operands_and_options(x: u64) -> u64
{
    let _0: u64; // return
    let x: u64; // arg #1
    let output: u64; // local
    let _3: u64; // anonymous local
    let _4: u64; // anonymous local
    let _5: u64; // anonymous local
    let _6: u64; // anonymous local

    storage_live(_0)
    storage_live(_6)
    storage_live(output)
    storage_live(_3)
    _3 = copy x
    asm!("mov {1}, {0}\n/* {{literal}} {0:e} {2} {3} {4} */", in(reg) move _3, lateout(reg) output, const 7i32, sym test_crate::asm_target, sym test_crate::ASM_STATIC, options(nomem, preserves_flags, nostack)) {
        fallthrough => {
            storage_dead(_3)
            asm!("mov {0}, {0}", inout(reg) copy x => x, options(pure, nomem)) {
                fallthrough => {
                    asm!("/* {{ */", out("ax") _, options(att_syntax)) {
                        fallthrough => {
                            storage_live(_4)
                            _4 = copy x
                            storage_live(_5)
                            _5 = copy output
                            _6 = copy _4 panic.+ copy _5
                            _0 = move _6
                            storage_dead(_5)
                            storage_dead(_4)
                            storage_dead(output)
                            storage_dead(_6)
                            storage_dead(x)
                            return
                        }
                    }
                    ↳⚡ undefined_behavior
                }
            }
            ↳⚡ undefined_behavior
        }
    }
    ↳⚡ undefined_behavior
}

